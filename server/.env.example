# Copy to server/.env and adjust. Real environment variables take precedence.

# development | production | test
NODE_ENV=development
PORT=4000

# REQUIRED in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# SQLite file path (defaults to server/data/taskflow.db)
DATABASE_PATH=

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Login/register attempts allowed per IP per window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
